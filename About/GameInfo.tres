[sub_resource type="Resource" id="Resource_ta2p3"]
script = ExtResource("4_w3b1a")
title = "Virus Invasion"
description = "Two characters in this game - \"Lieutenant Scareye\" and the \"Virus King\" - are adapted from the \"Virus Invasion\" series of games by YoYoGames Sandbox user Blublub. They are assumed to be the intellectual property of Blublub.

These characters are used here based on a long-established history of Blublub allowing and encouraging Virus Invasion fangames.

More generally, Advanced Invasion owes its main inspiration to Blublub as the originator of the \"virus game\" genre - a small subculture of platforming games about fending off computer viruses."
metadata/_custom_type_script = "uid://bjgnxatvg3ldr"

